---
const repo = import.meta.env.PUBLIC_GISCUS_REPO;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const enabled = repo && repoId && category && categoryId;
---

<section class="comments" data-pagefind-ignore>
  <h2>讨论</h2>
  {enabled ? (
    <>
      <p>
        评论由 Giscus 提供。参与讨论需要 GitHub 账户，加载评论会连接第三方服务。
      </p>
      <details>
        <summary>加载 GitHub 评论</summary>
        <div
          id="giscus"
          data-repo={repo}
          data-repo-id={repoId}
          data-category={category}
          data-category-id={categoryId}
        ></div>
      </details>
    </>
  ) : (
    <p>评论暂未开启。配置 GitHub Discussions 后可接入 Giscus。</p>
  )}
</section>
<script>
  const details =
    document.querySelector<HTMLDetailsElement>('.comments details');
  details?.addEventListener('toggle', () => {
    const target = document.querySelector<HTMLElement>('#giscus');
    if (!details.open || !target || target.dataset.loaded) return;
    target.dataset.loaded = 'true';
    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';
    const attrs = {
      repo: target.dataset.repo!,
      'repo-id': target.dataset.repoId!,
      category: target.dataset.category!,
      'category-id': target.dataset.categoryId!,
      mapping: 'specific',
      term: location.pathname.replace(/^\/en\//, '/'),
      strict: '1',
      'reactions-enabled': '1',
      'emit-metadata': '0',
      'input-position': 'top',
      theme: 'light',
      lang: document.documentElement.lang === 'en' ? 'en' : 'zh-CN',
    };
    Object.entries(attrs).forEach(([key, value]) =>
      script.setAttribute(`data-${key}`, value),
    );
    script.addEventListener('error', () => {
      target.textContent = document.documentElement.lang === 'en' ? 'Comments could not be loaded. Please try again.' : '评论加载失败，请稍后刷新重试。';
    });
    target.append(script);
  });
</script>
